{
  "name": "@takt/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.json",
    "test:rules": "vitest run",
    "test:components": "playwright test --project=components-chromium --project=components-firefox --project=components-webkit",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "svelte": "^5.39.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^24.5.0",
    "svelte-check": "^4.3.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
