{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takt.local/schemas/takt-v1.schema.json",
  "title": "Takt portable project v1",
  "type": "object",
  "required": ["format", "version", "title", "document", "view"],
  "properties": {
    "format": { "const": "takt" },
    "version": { "const": 1 },
    "title": { "type": "string" },
    "document": {
      "type": "object",
      "required": ["sections", "rows", "bars", "milestones"],
      "properties": {
        "display": { "enum": ["weeks", "dates"], "default": "weeks" },
        "calendar": {
          "type": "object",
          "required": ["week", "date"],
          "properties": {
            "week": { "$ref": "#/$defs/week" },
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "format": "date"
            }
          }
        },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
        "bars": { "type": "array", "items": { "$ref": "#/$defs/bar" } },
        "milestones": {
          "type": "array",
          "items": { "$ref": "#/$defs/milestone" }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["display"],
            "properties": { "display": { "const": "dates" } }
          },
          "then": { "required": ["calendar"] }
        }
      ]
    },
    "view": {
      "type": "object",
      "required": ["zoom", "firstWeek", "scrollTop", "collapsedSectionIds"],
      "properties": {
        "zoom": { "type": "number", "minimum": 0.125, "maximum": 2 },
        "firstWeek": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "scrollTop": { "type": "number", "minimum": 0 },
        "collapsedSectionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "\\S" },
    "week": {
      "type": "integer",
      "minimum": -1000000,
      "maximum": 1000000
    },
    "color": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
    "section": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "row": {
      "type": "object",
      "required": ["id", "sectionId", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sectionId": { "$ref": "#/$defs/id" },
        "name": { "type": "string" }
      }
    },
    "bar": {
      "type": "object",
      "required": ["id", "rowId", "start", "end", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "rowId": { "$ref": "#/$defs/id" },
        "start": { "$ref": "#/$defs/week" },
        "end": { "$ref": "#/$defs/week" },
        "name": { "type": "string" },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "milestone": {
      "type": "object",
      "required": ["id", "rowId", "boundary", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "rowId": { "$ref": "#/$defs/id" },
        "boundary": { "$ref": "#/$defs/week" },
        "name": { "type": "string" },
        "color": { "$ref": "#/$defs/color" }
      }
    }
  },
  "$comment": "Unknown properties are accepted and stripped. Codec additionally validates real calendar dates, global ID uniqueness, ownership/collapse references, positive bar durations, per-row overlap and duplicate milestone boundaries. JSON numbers must be finite. No artificial collection/string limits are imposed."
}
